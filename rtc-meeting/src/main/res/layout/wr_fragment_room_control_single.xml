<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:fab="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:padding="20dp">
    
    <ImageView
        android:id="@+id/wr_switch_mute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:src="@drawable/webrtc_btn_voice_mute"
        android:drawablePadding="5dp"
        android:gravity="center_horizontal"
        android:textColor="@android:color/white"
        android:textSize="@dimen/wr_control_text_size"
        fab:layout_constraintBottom_toBottomOf="parent"
        fab:layout_constraintEnd_toStartOf="@+id/guideline"
        fab:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/wr_switch_bluetooth"
        android:layout_width="57dp"
        android:layout_height="57dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:gravity="center_horizontal"
        android:scaleType="fitCenter"
        android:src="@drawable/bluetooth_circle_round_default"
        fab:layout_constraintBottom_toBottomOf="parent"
        fab:layout_constraintEnd_toStartOf="@+id/guideline3"
        fab:layout_constraintStart_toStartOf="@+id/guideline" />

    <ImageView
        android:id="@+id/wr_switch_hang_up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:src="@drawable/webrtc_cancel"
        android:drawablePadding="5dp"
        android:gravity="center_horizontal"
        android:textColor="@android:color/white"
        android:textSize="@dimen/wr_control_text_size"
        fab:layout_constraintBottom_toBottomOf="parent"
        fab:layout_constraintEnd_toStartOf="@+id/guideline2"
        fab:layout_constraintStart_toStartOf="@+id/guideline3" />

